{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PYTHONPATH": "${workspaceFolder}/src"
    }
  },
  "tasks": [
    {
      "label": "Run tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/run_evals.py"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run local agent server",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/run_agent_app.py"],
      "problemMatcher": []
    },
    {
      "label": "Run chat simulator (mock)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/run_periodic_chat_simulator.py", "once", "--mode", "mock", "--message-mode", "rule", "--state-backend", "memory"],
      "problemMatcher": []
    }
  ]
}
